{
  "name": "@inis-run/mastra",
  "version": "0.1.0",
  "description": "Mastra Workspace sandbox provider for inis.run — the EU sandbox: built and run in Ireland, your code and data stay in Europe",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inis-run/sdk.git",
    "directory": "mastra"
  },
  "homepage": "https://inis.run",
  "bugs": {
    "url": "https://github.com/inis-run/sdk/issues"
  },
  "keywords": ["inis", "sandbox", "agents", "llm", "mastra", "workspace"],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@mastra/core": "^1.55.0",
    "@inis-run/sdk": "^0.1.0"
  },
  "devDependencies": {
    "@mastra/core": "1.55.0",
    "@types/node": "^22.19.11",
    "@inis-run/sdk": "file:../typescript",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "zod": "^4.0.0"
  }
}
