{
  "name": "@inis-run/ai-sdk",
  "version": "0.1.0",
  "description": "Vercel AI SDK tools for inis.run sandboxes",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./lifecycle": {
      "types": "./dist/lifecycle.d.ts",
      "import": "./dist/lifecycle.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inis-run/sdk.git",
    "directory": "ai-sdk"
  },
  "homepage": "https://inis.run",
  "bugs": {
    "url": "https://github.com/inis-run/sdk/issues"
  },
  "keywords": ["inis", "sandbox", "agents", "llm", "ai-sdk", "vercel"],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "ai": "^5.0.0",
    "@inis-run/sdk": "^0.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.11",
    "ai": "^5.0.223",
    "@inis-run/sdk": "file:../typescript",
    "msw": "^2.15.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "zod": "^3.24.2"
  }
}
